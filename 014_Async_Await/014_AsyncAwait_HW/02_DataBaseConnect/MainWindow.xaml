<Window x:Class="DataBaseConnect.MainWindow"        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBaseConnect"
        mc:Ignorable="d"
        Title="DB Connect" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="MainTextBox" 
                 Grid.Row="0"
                 Margin="0,0,0,10"
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" 
                 AcceptsReturn="True"
                 IsReadOnly="True"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ConnectButton" Content="Connect" Width="120" Margin="5" Click="ConnectButton_Click"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Width="120" Margin="5" Click="DisconnectButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
